-- Параметры модели (подобраны под 1 МБ оперативной памяти)
-- EmbedDim 16, Hidden 64, Context 5. 
-- Словарь 2000. Весов: (5*16)*64 + 64*2000 = 5120 + 128000 = ~133k весов. 
-- Это ~0.5-1 МБ в памяти Luau. Идеально.
local aiModel
local buffer

local function initAI()
    log("Инициализация нейросети...")
    
    -- Создаем словарь до конца (резервируем место)
    -- В реальности словарь растет по мере ввода, но мы задаем лимит.
    
    aiModel = NeuralNet.new(Vocab.maxSize, 16, 64, 5)
    buffer = ReplayBuffer.new(3000)
    
    -- Обучение "алфавиту" (чтобы модель не выдавала чистый рандом в начале)
