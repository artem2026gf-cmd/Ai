-- ============================================================
-- ЧАСТЬ 8: БУФЕР ПАМЯТИ (REPLAY BUFFER)
-- ============================================================
local ReplayBuffer = {}
ReplayBuffer.__index = ReplayBuffer

function ReplayBuffer.new(maxSize)
    local self = setmetatable({}, ReplayBuffer)
    self.maxSize = maxSize or 2000
    self.data = {}      -- {context = {ids}, target = id}
    self.size = 0
    return self
end

function ReplayBuffer:add(context, target)
    self.size = self.size + 1
    if self.size > self.maxSize then
        -- Выкидываем старые (FIFO)
        table.remove(self.data, 1)
        self.size = self.size - 1
    end
    table.insert(self.data, {context = context, target = target})
end

function ReplayBuffer:sampleBatch(batchSize)
    if #self.data == 0 then return {} end
    local batch = {}
    for i = 1, batchSize do
        local idx = math.random(1, #self.data)
        table.insert(batch, self.data[idx])
    end
    return batch
end

function ReplayBuffer:empty()
    return #self.data == 0
end

-- ============================================================
-- ОБУЧЕНИЕ НА БУФЕРЕ (BATCH TRAIN)
-- ============================================================
-- Эта функция будет вызываться в фоне, чтобы модель училась пока ты играешь
local function trainOnBuffer(net, buffer, epochs, batchSize)
    if buffer:empty() then return 0 end
    
    local totalLoss = 0
    local steps = 0
    
    for epoch = 1, epochs do
        local batch = buffer:sampleBatch(batchSize)
        for _, sample in ipairs(batch) do
            local loss = net:safeTrain(sample.context, sample.target, net.learningRate)
            totalLoss = totalLoss + loss
            steps = steps + 1
            
            -- Защита от фризов: отдаем поток раз в 10 шагов
            if steps % 10 == 0 then
                task.wait()
            end
        end
    end
    
    if steps == 0 then return 0 end
    return totalLoss / steps
end
-- ============================================================
-- ЧАСТЬ 9: ГЕНЕРАТОР ТЕКСТА (ИНФЕРЕНС)
-- ============================================================

-- Генерирует ответ на основе входного текста
function NeuralNet:generate(inputText, maxTokens, temperature)
    local net = self
    local context = {} -- текущий контекст (ID)
    
    -- 1. Токенизируем вход
    local words = tokenize(inputText)
    
    -- Заполняем контекст (если слов меньше, чем contextSize, добиваем <pad>)
    for i = 1, self.contextSize do
        local w = words[#words - self.contextSize + i]
        if w then
            table.insert(context, Vocab:get(w))
        else
            table.insert(context, 2) -- <pad>
        end
    end
    
    local outputWords = {}
    
    -- 2. Генерируем по одному слову
    for i = 1, maxTokens do
        local probs = net:forward(context)
        
        -- Выбор токена
        local tokenId = Util.sample(probs, temperature)
        
        -- Если сгенерировали <pad> или <unk>, пропускаем
        if tokenId ~= 2 and tokenId ~= 1 then
            local word = Vocab:getWord(tokenId)
            table.insert(outputWords, word)
            
            -- Если точка — заканчиваем
            if word == "." or word == "!" or word == "?" then
                break
            end
        end
        
        -- Сдвигаем контекст (убираем старый, добавляем новый)
        table.remove(context, 1)
        table.insert(context, tokenId)
        
        -- Даем потоку вздохнуть
        task.wait()
    end
    
    -- 3. Собираем строку
    if #outputWords == 0 then return "..." end
    local res = table.concat(outputWords, " ")
    
    -- Капитализация (первая буква)
    local first = res:byte(1)
    if first and first >= 97 and first <= 122 then
        res = res:gsub("^%l", string.upper)
    elseif first and (first == 208 or first == 209) then
        -- Для кириллицы оставляем как есть, чтобы не сломать байты
    end
    
    if not res:match("[%.%!%?]$") then res ..= "." end
    return res
end

