local function onSend()
    if not aiModel then
        addMessage("Сеть еще грузится, подожди...", false)
        return
    end

    local text = textBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" then return end
    textBox.Text = ""

    -- 1. Показываем сообщение пользователя
    addMessage(text, true)

    -- 2. Подготовка к обучению (добавляем в буфер)
    local words = tokenize(text)
    for i = 1, #words do
        Vocab:add(words[i])
    end
    
    -- Учим нейросеть предсказывать следующее слово в этом тексте
    for i = 1, #words - 1 do
        local ctx = {}
        for j = 1, 5 do
            local idx = i - 5 + j
            if idx >= 1 and words[idx] then
                table.insert(ctx, Vocab:get(words[idx]))
            else
                table.insert(ctx, 2) -- <pad>
            end
        end
        buffer:add(ctx, Vocab:get(words[i+1]))
    end

    -- 3. Индикатор печати и генерация
    local typingMsg = showTyping()

    task.spawn(function()
        -- Даем модели время "подумать" (эмуляция)
        task.wait(math.random(50, 120) / 100)
        
        -- Генерируем ответ
        local answer = aiModel:generate(text, 10, 0.8)
        
        -- Убираем индикатор и показываем ответ
        typingMsg:Destroy()
        addMessage(answer, false)
        
        -- Обновляем статус
        status.Text = string.format("Сеть: %d слов | Буфер: %d", Vocab.size, buffer.size)
        
        -- Фоновое обучение (чтобы не лагало GUI)
        task.spawn(function()
            local loss = trainOnBuffer(aiModel, buffer, 1, 10)
            -- Можно вывести loss в консоль для дебага
            -- log(string.format("Loss: %.4f", loss))
        end)
    end)
end

