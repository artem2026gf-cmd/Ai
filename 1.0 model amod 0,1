-- Сохраняем веса в формате JSON (через HttpService)
-- Это позволит ИИ помнить диалоги после перезапуска скрипта.

local HttpService = game:GetService("HttpService")
local SAVE_FILE = "neuro_ai_weights.json"

-- Функция сохранения (вызывается кнопкой или автоматически)
local function saveModel()
    if not aiModel then return end
    
    local saveData = {
        vocab = {
            words = Vocab.words,
            reverse = Vocab.reverse,
            size = Vocab.size
        },
        embedding = aiModel.embedding.weights,
        hidden = {
            weights = aiModel.hidden.weights,
            biases = aiModel.hidden.biases
        },
        output = {
            weights = aiModel.output.weights,
            biases = aiModel.output.biases
        }
    }
    
    local success, json = pcall(function()
        return HttpService:JSONEncode(saveData)
    end)
    
    if success and writefile then
        pcall(writefile, SAVE_FILE, json)
        log("Модель сохранена в " .. SAVE_FILE)
        addMessage("(система): память сохранена на диск.", false)
    end
end

-- Функция загрузки (вызывается при старте)
local function loadModel()
    if not (isfile and isfile(SAVE_FILE)) then return false end
    
    local success, data = pcall(function()
        local raw = readfile(SAVE_FILE)
        return HttpService:JSONDecode(raw)
    end)
    
    if not success or not data then return false end
    
    -- Восстанавливаем словарь
    Vocab.words = data.vocab.words or {}
    Vocab.reverse = data.vocab.reverse or {}
    Vocab.size = data.vocab.size or 0
    
    -- Восстанавливаем веса
    if data.embedding then
        for i = 1, #data.embedding do
            aiModel.embedding.weights[i] = data.embedding[i]
        end
    end
    if data.hidden then
        for i = 1, #data.hidden.weights do
            aiModel.hidden.weights[i] = data.hidden.weights[i]
            aiModel.hidden.biases[i] = data.hidden.biases[i]
        end
    end
    if data.output then
        for i = 1, #data.output.weights do
            aiModel.output.weights[i] = data.output.weights[i]
            aiModel.output.biases[i] = data.output.biases[i]
        end
    end
    
    log("Модель успешно загружена из " .. SAVE_FILE)
    status.Text = string.format("Память загружена: %d слов", Vocab.size)
    return true
end

