-- ============================================================
-- ЧАСТЬ 6: BACKPROPAGATION (ОБРАТНЫЙ ПРОХОД ДЛЯ DENSE)
-- ============================================================

-- Добавляем метод backward в Dense
function Dense:backward(outputGradient, lr)
    -- outputGradient: dL/dOut (размер outFeatures)
    -- Возвращаем inputGradient: dL/dInput (размер inFeatures)
    
    local inputGradient = Util.createArray(self.inFeatures, 0)
    local dZ = Util.createArray(self.outFeatures, 0)
    
    -- 1. dZ = dOut * activation'(Z)
    for i = 1, self.outFeatures do
        if self.activation == "relu" then
            dZ[i] = outputGradient[i] * Util.reluDeriv(self.lastZ[i])
        elseif self.activation == "sigmoid" then
            local s = Util.sigmoid(self.lastZ[i])
            dZ[i] = outputGradient[i] * s * (1 - s)
        else
            dZ[i] = outputGradient[i] -- linear
        end
    end
    
    -- 2. Обновляем веса и считаем градиент по входу
    for i = 1, self.outFeatures do
        local dz = dZ[i]
        if dz ~= 0 then
            -- Обновляем bias
            self.biases[i] = self.biases[i] - lr * dz
            
            -- Обновляем веса и копим inputGradient
            local row = self.weights[i]
            for j = 1, self.inFeatures do
                -- dL/dW = dZ * Input
                local gradW = dz * self.lastInput[j]
                self.weights[i][j] = row[j] - lr * gradW
                
                -- dL/dInput += W * dZ
                inputGradient[j] = inputGradient[j] + row[j] * dz
            end
        end
    end
    
    return inputGradient
end
-- ============================================================
-- ЧАСТЬ 7: ФУНКЦИЯ ПОТЕРЬ И ОБУЧЕНИЕ
-- ============================================================

-- Добавляем метод train в NeuralNet
function NeuralNet:train(contextIds, targetId, lr)
    lr = lr or self.learningRate
    
    -- 1. FORWARD PASS (запоминаем состояние)
    local flat = {}
    for i = 1, self.contextSize do
        local id = contextIds[i] or 2
        local emb = self.embedding:forward(id)
        for j = 1, self.embedDim do
            table.insert(flat, emb[j])
        end
    end
    
    local h = self.hidden:forward(flat)
    local logits = self.output:forward(h)
    local probs = Util.softmax(logits)
    
    -- 2. CROSS-ENTROPY LOSS
    -- Loss = -log(prob[target])
    local p = math.max(probs[targetId], 1e-7)
    local loss = -math.log(p)
    
    -- 3. ГРАДИЕНТ ОТ ВЫХОДА
    -- dL/dLogits = probs - one_hot(target)
    local dLogits = table.create(self.vocabSize)
    for i = 1, self.vocabSize do
        dLogits[i] = probs[i] - (i == targetId and 1 or 0)
    end
    
    -- 4. BACKWARD PASS
    local dHidden = self.output:backward(dLogits, lr)
    local dFlat = self.hidden:backward(dHidden, lr)
    
    -- 5. ОБНОВЛЕНИЕ ЭМБЕДДИНГОВ
    -- dFlat разбит на куски по embedDim для каждого слова в контексте
    local idx = 1
    for i = 1, self.contextSize do
        local id = contextIds[i] or 2
        for j = 1, self.embedDim do
            local grad = dFlat[idx]
            if grad ~= 0 then
                -- Обновляем эмбеддинг для этого слова
                self.embedding.weights[id][j] = self.embedding.weights[id][j] - lr * grad
            end
            idx = idx + 1
        end
    end
    
    return loss
end

-- Безопасный вызов train с pcall (защита от NaN)
function NeuralNet:safeTrain(contextIds, targetId, lr)
    local success, loss = pcall(function()
        return self:train(contextIds, targetId, lr)
    end)
    
    if success and type(loss) == "number" and loss == loss then
        return loss
    else
        return 0
    end
end

