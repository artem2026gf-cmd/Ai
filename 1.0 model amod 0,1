-- ============================================================
-- ЧАСТЬ 3: ТОКЕНИЗАТОР И СЛОВАРЬ
-- ============================================================
local Vocab = {
    words = {},       -- слово -> индекс (ID)
    reverse = {},     -- индекс -> слово
    size = 0,
    maxSize = 2000,   -- Ограничим словарь, чтобы не сожрал память
}

function Vocab:add(word)
    if self.words[word] then return self.words[word] end
    if self.size >= self.maxSize then return 1 end -- 1 = <unk>
    
    self.size = self.size + 1
    self.words[word] = self.size
    self.reverse[self.size] = word
    return self.size
end

function Vocab:get(word)
    return self.words[word] or 1 -- 1 = <unk>
end

function Vocab:getWord(id)
    return self.reverse[id] or "<unk>"
end

-- Добавляем служебные токены
Vocab:add("<unk>")  -- Индекс 1
Vocab:add("<pad>")  -- Индекс 2 (для выравнивания длины)
Vocab:add(".")      -- Индекс 3 (конец предложения)

-- Токенизатор для русского и английского
local function tokenize(text)
    local out = {}
    text = text:lower()
    
    local current = {}
    for i = 1, #text do
        local b = text:byte(i)
        -- ASCII буквы/цифры
        if (b >= 97 and b <= 122) or (b >= 48 and b <= 57) then
            table.insert(current, string.char(b))
        -- Кириллица (UTF-8)
        elseif b == 208 or b == 209 then
            local next_b = text:byte(i + 1)
            if next_b and next_b >= 128 and next_b <= 191 then
                table.insert(current, string.sub(text, i, i + 1))
                i = i + 1
            end
        else
            -- Разделитель
            if #current > 0 then
                table.insert(out, table.concat(current))
                current = {}
            end
        end
    end
    if #current > 0 then table.insert(out, table.concat(current)) end
    
    -- Ограничиваем длину ввода (контекст)
    if #out > 20 then
        local short = {}
        for i = #out - 19, #out do
            table.insert(short, out[i])
        end
        out = short
    end
    
    return out
end

