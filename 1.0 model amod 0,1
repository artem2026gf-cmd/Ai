local Util = {}

-- Быстрый рандом для весов (Gaussian)
function Util.randomWeight()
    -- Box-Muller для нормального распределения
    local u1 = math.random()
    local u2 = math.random()
    return math.sqrt(-2 * math.log(u1 + 1e-9)) * math.cos(2 * math.pi * u2) * 0.1
end

-- Создание массива
function Util.createArray(size, fill)
    local arr = table.create(size)
    for i = 1, size do
        arr[i] = fill or 0
    end
    return arr
end

-- Создание матрицы (2D)
function Util.createMatrix(rows, cols)
    local m = table.create(rows)
    for i = 1, rows do
        m[i] = Util.createArray(cols, 0)
    end
    return m
end

-- Функция активации ReLU
function Util.relu(x)
    return x > 0 and x or 0
end

-- Производная ReLU
function Util.reluDeriv(x)
    return x > 0 and 1 or 0
end

-- Функция активации Sigmoid
function Util.sigmoid(x)
    return 1 / (1 + math.exp(-x))
end

-- Softmax для выходного слоя (вероятности слов)
function Util.softmax(arr)
    local max = -math.huge
    for i = 1, #arr do
        if arr[i] > max then max = arr[i] end
    end
    local sum = 0
    local out = table.create(#arr)
    for i = 1, #arr do
        out[i] = math.exp(arr[i] - max)
        sum = sum + out[i]
    end
    for i = 1, #arr do
        out[i] = out[i] / sum
    end
    return out
end

-- Выбор по вероятностям (Sampling)
function Util.sample(probs, temp)
    temp = temp or 1.0
    local sum = 0
    local scaled = table.create(#probs)
    for i = 1, #probs do
        scaled[i] = math.pow(probs[i], 1 / temp)
        sum = sum + scaled[i]
    end
    local r = math.random() * sum
    local acc = 0
    for i = 1, #probs do
        acc = acc + scaled[i]
        if acc >= r then return i end
    end
    return #probs
end

