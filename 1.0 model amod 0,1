-- Чтобы модель не выдавала сразу полный бред, 
-- "скормим" ей базовые фразы для разогрева эмбеддингов.

local function warmupModel()
    if not aiModel then return end
    
    local seedPhrases = {
        "привет как дела",
        "я искусственный интеллект",
        "что ты умеешь",
        "я умею думать и учиться",
        "расскажи мне что-нибудь",
        "я люблю учиться новому",
    }
    
    for _, phrase in ipairs(seedPhrases) do
        local words = tokenize(phrase)
        for _, w in ipairs(words) do
            Vocab:add(w)
        end
        
        -- Формируем контексты
        for i = 1, #words - 1 do
            local ctx = {}
            for j = 1, 5 do
                local idx = i - 5 + j
                if idx >= 1 and words[idx] then
                    table.insert(ctx, Vocab:get(words[idx]))
                else
                    table.insert(ctx, 2) -- <pad>
                end
            end
            buffer:add(ctx, Vocab:get(words[i+1]))
        end
    end
    
    -- Прогоняем 3 эпохи обучения на этих фразах, чтобы веса ожили
    trainOnBuffer(aiModel, buffer, 3, 8)
    log("Модель разогрета на базовых фразах.")
end

-- Безопасный вызов генерации (обертка)
function NeuralNet:safeGenerate(text, maxTokens, temp)
    local success, result = pcall(function()
        return self:generate(text, maxTokens, temp)
    end)
    
    if success and type(result) == "string" and #result > 0 then
        return result
    else
        return "я пока не знаю что ответить, научи меня."
    end
end

