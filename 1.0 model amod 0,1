-- ============================================================
-- ЧАСТЬ 4: АРХИТЕКТУРА (ЭМБЕДДИНГИ И СЛОЙ)
-- ============================================================
local Embedding = {}
Embedding.__index = Embedding

function Embedding.new(vocabSize, embedDim)
    local self = setmetatable({}, Embedding)
    self.vocabSize = vocabSize
    self.embedDim = embedDim
    
    -- Матрица весов: vocabSize x embedDim
    self.weights = Util.createMatrix(vocabSize, embedDim)
    for i = 1, vocabSize do
        for j = 1, embedDim do
            self.weights[i][j] = Util.randomWeight()
        end
    end
    return self
end

function Embedding:forward(id)
    -- Возвращаем вектор эмбеддинга для ID
    local vec = table.create(self.embedDim)
    local row = self.weights[id]
    for i = 1, self.embedDim do
        vec[i] = row[i]
    end
    return vec
end

-- ============================================================
-- Линейный слой (Dense / Linear)
-- ============================================================
local Dense = {}
Dense.__index = Dense

function Dense.new(inFeatures, outFeatures, activation)
    local self = setmetatable({}, Dense)
    self.inFeatures = inFeatures
    self.outFeatures = outFeatures
    self.activation = activation or "relu"
    
    self.weights = Util.createMatrix(outFeatures, inFeatures)
    self.biases = Util.createArray(outFeatures, 0)
    
    for i = 1, outFeatures do
        for j = 1, inFeatures do
            self.weights[i][j] = Util.randomWeight()
        end
        self.biases[i] = 0.01
    end
    
    -- Кэш для backprop
    self.lastInput = {}
    self.lastOutput = {}
    self.lastZ = {}
    return self
end

function Dense:forward(input)
    self.lastInput = input
    
    local out = Util.createArray(self.outFeatures, 0)
    local z = Util.createArray(self.outFeatures, 0)
    
    -- Z = W * X + B
    for i = 1, self.outFeatures do
        local sum = self.biases[i]
        local row = self.weights[i]
        for j = 1, self.inFeatures do
            sum = sum + row[j] * input[j]
        end
        z[i] = sum
        
        if self.activation == "relu" then
            out[i] = Util.relu(sum)
        elseif self.activation == "sigmoid" then
            out[i] = Util.sigmoid(sum)
        else
            out[i] = sum
        end
    end
    
    self.lastZ = z
    self.lastOutput = out
    return out
end
-- ============================================================
-- ЧАСТЬ 5: СБОРКА МОДЕЛИ (Оркестратор)
-- ============================================================
local NeuralNet = {}
NeuralNet.__index = NeuralNet

function NeuralNet.new(vocabSize, embedDim, hiddenDim, contextSize)
    local self = setmetatable({}, NeuralNet)
    self.vocabSize = vocabSize
    self.embedDim = embedDim
    self.hiddenDim = hiddenDim
    self.contextSize = contextSize
    
    -- 1. Слой эмбеддингов
    self.embedding = Embedding.new(vocabSize, embedDim)
    
    -- 2. Линейный слой для сборки контекста (Flatten: contextSize * embedDim -> hiddenDim)
    self.hidden = Dense.new(contextSize * embedDim, hiddenDim, "relu")
    
    -- 3. Выходной слой (hiddenDim -> vocabSize)
    self.output = Dense.new(hiddenDim, vocabSize, "none")
    
    -- Гиперпараметры
    self.learningRate = 0.01
    return self
end

function NeuralNet:forward(contextIds)
    -- contextIds: таблица из N ID (длина = contextSize)
    -- 1. Получаем эмбеддинги для каждого ID и склеиваем
    local flat = {}
    for i = 1, self.contextSize do
        local id = contextIds[i] or 2 -- <pad> если пусто
        local emb = self.embedding:forward(id)
        for j = 1, self.embedDim do
            table.insert(flat, emb[j])
        end
    end
    
    -- 2. Проходим через скрытый слой
    local h = self.hidden:forward(flat)
    
    -- 3. Получаем логиты (выходной слой)
    local logits = self.output:forward(h)
    
    -- 4. Softmax для вероятностей
    local probs = Util.softmax(logits)
    
    return probs
end

